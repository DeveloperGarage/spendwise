{
  "expo": {
    "name": "Spendwise",
    "slug": "spendwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C5CE7",
        "foregroundImage": "./assets/images/brand-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/brand-logo.png",
      "name": "Spendwise",
      "shortName": "Spendwise",
      "themeColor": "#6C5CE7",
      "backgroundColor": "#FFFFFF",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C5CE7",
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
